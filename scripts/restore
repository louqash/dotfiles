#!/usr/bin/env bash
#
# Restore files from a backup made by scripts/backup.
#
# The backup lives on an exFAT drive that stores filenames in decomposed
# Unicode (NFD). This script uses GNU rsync's --iconv to convert them back to
# macOS's composed form (NFC), so restored names are byte-identical to the
# originals. (NFD also works fine on macOS; the conversion matters for a clean
# round-trip and when restoring onto Linux.)
#
# SAFETY:
#   * Dry run by default — nothing is written until you pass --go.
#   * Never deletes anything from the restore target unless you pass --mirror
#     (which makes the target an EXACT copy of the backup, removing extras).
#   * The backup is only ever read from, never modified.
#
set -euo pipefail

usage() {
    cat <<EOF
Usage: $(basename "$0") [--go] [--mirror] [--into DIR] [--only NAME] <backup_drive>

  <backup_drive>  Mount point of the backup drive, e.g. /Volumes/ADATA
                  (restores from <backup_drive>/Backup/<name>/)

  --go            Actually write files. Without this, it's a dry run.
  --mirror        Make each target an exact copy of the backup, DELETING files
                  in the target that aren't in the backup. Dangerous — off by
                  default so a restore never removes your newer local files.
  --into DIR      Restore under DIR/<name> instead of the original locations.
                  Great for inspecting a restore before trusting it.
  --only NAME     Restore just one backed-up folder (e.g. "workplace").

Backed-up folders and where they restore to by default:
EOF
    for n in "${RESTORE_NAMES[@]}"; do
        printf '  %-14s -> %s\n' "$n" "${TARGETS[$n]}"
    done
    exit 1
}

# --- what can be restored (must mirror BACKUP_DIRS in scripts/backup) --------

RESTORE_NAMES=( "Second Brain" "nextcloud" "workplace" )
declare -A TARGETS=(
    ["Second Brain"]="$HOME/Documents/Second Brain"
    ["nextcloud"]="$HOME/nextcloud"
    ["workplace"]="$HOME/workplace"
)

# --- parse arguments --------------------------------------------------------

GO=0
MIRROR=0
INTO=""
ONLY=""
SRC_DRIVE=""

while [ $# -gt 0 ]; do
    case "$1" in
        --go)     GO=1 ;;
        --mirror) MIRROR=1 ;;
        --into)   shift; INTO="${1:-}"; [ -n "$INTO" ] || usage ;;
        --only)   shift; ONLY="${1:-}"; [ -n "$ONLY" ] || usage ;;
        -h|--help) usage ;;
        -*)       echo "Unknown option: $1" >&2; usage ;;
        *)
            if [ -n "$SRC_DRIVE" ]; then
                echo "Error: more than one backup drive given" >&2; usage
            fi
            SRC_DRIVE="$1"
            ;;
    esac
    shift
done

[ -n "$SRC_DRIVE" ] || usage
SRC_DRIVE="${SRC_DRIVE%/}"
BACKUP_PATH="$SRC_DRIVE/Backup"
INTO="${INTO%/}"

if [ -n "$ONLY" ] && [ -z "${TARGETS[$ONLY]:-}" ]; then
    echo "Error: '$ONLY' is not a backed-up folder. Choose one of:" >&2
    printf '  %s\n' "${RESTORE_NAMES[@]}" >&2
    exit 1
fi

# --- preflight --------------------------------------------------------------

log() { printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }

[ -d "$BACKUP_PATH" ] || { echo "Error: no backup found at '$BACKUP_PATH'" >&2; exit 1; }

# Prefer a GNU rsync for --iconv (Apple's openrsync lacks it).
RSYNC_BIN=""
for cand in /opt/homebrew/bin/rsync /usr/local/bin/rsync "$(command -v rsync || true)"; do
    if [ -n "$cand" ] && [ -x "$cand" ]; then RSYNC_BIN="$cand"; break; fi
done
[ -n "$RSYNC_BIN" ] || { echo "Error: no rsync found in PATH" >&2; exit 1; }

RSYNC_HELP="$("$RSYNC_BIN" --help 2>&1 || true)"
rsync_supports() { grep -q -- "$1" <<<"$RSYNC_HELP"; }

# --- rsync options ----------------------------------------------------------

# -rlt matches the backup (no perms/owner/group to avoid exFAT noise). No
# --delete unless the user explicitly asked to mirror.
RSYNC_OPTS=(
    -rlt
    --modify-window=2
    --itemize-changes
    --stats
)
[ "$GO"     -eq 0 ] && RSYNC_OPTS+=(--dry-run)
[ "$MIRROR" -eq 1 ] && RSYNC_OPTS+=(--delete)

# Convert decomposed (NFD) backup names back to composed (NFC) — the reverse of
# the backup's --iconv. Direction verified empirically against the drive.
if rsync_supports '--iconv'; then
    RSYNC_OPTS+=(--iconv=utf-8-mac,utf-8)
else
    echo "WARNING: '$RSYNC_BIN' has no --iconv support; restored names will be" >&2
    echo "         decomposed (NFD). Fine on macOS, but not a byte-perfect" >&2
    echo "         round-trip. Install GNU rsync: brew install rsync" >&2
    echo >&2
fi

rsync_supports '--human-readable' && RSYNC_OPTS+=(--human-readable)

# --- run --------------------------------------------------------------------

if [ "$GO" -eq 0 ]; then
    log "*** DRY RUN — nothing will be written. Re-run with --go to restore. ***"
else
    log "*** RESTORING FOR REAL${MIRROR:+ (mirror mode)} ***"
    [ "$MIRROR" -eq 1 ] && \
        log "!!! --mirror will DELETE files in the target that aren't in the backup"
fi

status=0
for name in "${RESTORE_NAMES[@]}"; do
    [ -n "$ONLY" ] && [ "$name" != "$ONLY" ] && continue

    src="$BACKUP_PATH/$name"
    if [ ! -d "$src" ]; then
        log "SKIP  $name — not present in this backup"
        continue
    fi

    if [ -n "$INTO" ]; then
        target="$INTO/$name"
    else
        target="${TARGETS[$name]}"
    fi

    log "Restoring: $name -> $target"
    [ "$GO" -eq 1 ] && mkdir -p "$target"

    # Trailing slash on "$src/": restore the folder's *contents* into target/.
    set +e
    "$RSYNC_BIN" "${RSYNC_OPTS[@]}" "$src/" "$target/"
    rc=$?
    set -e

    case "$rc" in
        0)  log "OK    $name" ;;
        *)  status=1; log "FAIL  $name (rsync exit $rc)" ;;
    esac
    echo
done

if [ "$GO" -eq 0 ]; then
    log "Dry run complete. Add --go to perform the restore."
fi
exit "$status"
