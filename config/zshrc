# ----- HELPERS -----
_have() { command -v "$1" >/dev/null 2>&1; }

# ----- ALIASES -----
alias ll="ls -alF"
alias la="ls -A"
alias l="ls -CF"
alias gti="git"
alias ..="cd .."

# ----- SSH-AGENT -----
SSH_ENV="$HOME/.ssh/environment"
SSH_AGENT_BIN="$(command -v ssh-agent || true)"

start_agent() {
    echo "Initialising new SSH agent..."
    "$SSH_AGENT_BIN" | sed 's/^echo/#echo/' > "${SSH_ENV}"
    echo succeeded
    chmod 600 "${SSH_ENV}"
    . "${SSH_ENV}" > /dev/null
}

# Only start agent if we have ssh-agent available
if [[ -n "$SSH_AGENT_BIN" ]]; then
    if [[ -f "${SSH_ENV}" ]]; then
        . "${SSH_ENV}" > /dev/null
        # Check if the agent is still running
        if ! kill -0 "${SSH_AGENT_PID}" 2>/dev/null; then
            start_agent
        fi
    else
        start_agent
    fi
fi

# ----- HISTORY FIX -----
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000000
SAVEHIST=10000000
setopt BANG_HIST                 # Treat the '!' character specially during expansion.
setopt EXTENDED_HISTORY          # Write the history file in the ":start:elapsed;command" format.
setopt INC_APPEND_HISTORY        # Write to the history file immediately, not when the shell exits.
setopt SHARE_HISTORY             # Share history between all sessions.
setopt HIST_EXPIRE_DUPS_FIRST    # Expire duplicate entries first when trimming history.
setopt HIST_IGNORE_DUPS          # Don't record an entry that was just recorded again.
setopt HIST_IGNORE_ALL_DUPS      # Delete old recorded entry if new entry is a duplicate.
setopt HIST_FIND_NO_DUPS         # Do not display a line previously found.
setopt HIST_IGNORE_SPACE         # Don't record an entry starting with a space.
setopt HIST_SAVE_NO_DUPS         # Don't write duplicate entries in the history file.
setopt HIST_REDUCE_BLANKS        # Remove superfluous blanks before recording entry.
setopt HIST_VERIFY               # Don't execute immediately upon history expansion.
unsetopt BEEP                    # Disable terminal bell.
setopt HIST_BEEP                 # Beep when accessing nonexistent history.

# ----- EXPORTS -----
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"
export TERM="xterm-256color"
export CLICOLOR=1
export AWS_DEFAULT_PROFILE=dev-sandbox-0-engineer

bindkey -v
bindkey "^R" history-incremental-search-backward
bindkey "^I" expand-or-complete

# ----- BASE PATH -----
export PATH="$PATH:$HOME/.local/bin"
export PATH="$PATH:$HOME/scripts"
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

# ----- HOMEBREW (macOS + Linuxbrew) -----
# Find brew wherever it lives and load its shell environment.
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew \
             /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do
    if [[ -x "$_brew" ]]; then
        eval "$("$_brew" shellenv)"
        break
    fi
done
unset _brew

# Homebrew-provided tooling (mostly macOS). Each entry is a no-op if not installed.
if _have brew; then
    HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-$(brew --prefix)}"
    _gnubin="$(brew --prefix make 2>/dev/null)/libexec/gnubin"
    [[ -d "$_gnubin" ]] && export PATH="$_gnubin:$PATH"
    [[ -d "$HOMEBREW_PREFIX/opt/helm@3/bin" ]]     && export PATH="$HOMEBREW_PREFIX/opt/helm@3/bin:$PATH"
    [[ -d "$HOMEBREW_PREFIX/opt/binutils/bin" ]]   && export PATH="$HOMEBREW_PREFIX/opt/binutils/bin:$PATH"
    [[ -d "$HOMEBREW_PREFIX/opt/openjdk@21/bin" ]] && export PATH="$HOMEBREW_PREFIX/opt/openjdk@21/bin:$PATH"
    [[ -d "$HOMEBREW_PREFIX/share/google-cloud-sdk/bin" ]] && \
        export PATH="$HOMEBREW_PREFIX/share/google-cloud-sdk/bin:$PATH"
    unset _gnubin
fi

# Extra tool locations (added only if present)
[[ -d "$HOME/.opencode/bin" ]] && export PATH="$HOME/.opencode/bin:$PATH"
[[ -d "$HOME/.elan/bin" ]]     && export PATH="$HOME/.elan/bin:$PATH"

# ----- COMPLETIONS -----
# Set up all fpath entries before compinit
fpath+=~/.zfunc
fpath+=("$HOME/.zsh/pure")
[[ -n "${HOMEBREW_PREFIX:-}" ]] && fpath+=("$HOMEBREW_PREFIX/share/zsh/site-functions")

autoload -Uz compinit
export ZCOMPDUMP="$HOME/.zcompdump"
if [[ ! -f "$ZCOMPDUMP" || ! -s "$ZCOMPDUMP" || -n "$ZCOMPDUMP"(#qN.mh+24) ]]; then
  # Regenerate if file doesn't exist, is empty, or older than 24 hours
  compinit
else
  # Use cached version, skip security checks
  compinit -C
fi
unset ZCOMPDUMP

# ----- FZF -----
_have fzf && source <(fzf --zsh) 2>/dev/null

# ----- PROMPT -----
autoload -U promptinit; promptinit
# Use pure if available (brew on macOS, ~/.zsh/pure elsewhere), else a plain prompt.
if (( ${prompt_themes[(I)pure]} )); then
  prompt pure
else
  PROMPT='%F{blue}%n@%m%f %F{cyan}%~%f %# '
fi

# ----- EDITOR / VIM -----
if _have nvim; then
  alias vim="nvim"
  alias vi="nvim"
  export EDITOR="nvim"
elif _have vim; then
  export EDITOR="vim"
else
  export EDITOR="vi"
fi

# ----- PYENV -----
export PYENV_ROOT="${PYENV_ROOT:-$HOME/.pyenv}"
[[ -d "$PYENV_ROOT/bin" ]] && export PATH="$PYENV_ROOT/bin:$PATH"
if _have pyenv; then
  # Use --no-rehash for faster startup (rehash happens automatically on pyenv commands)
  eval "$(pyenv init - --no-rehash zsh)"
fi

# ----- DIRENV -----
_have direnv && eval "$(direnv hook zsh)"

# ----- NVM -----
export NVM_DIR="$HOME/.nvm"
# Add NVM's current version to PATH so all npm-installed commands work
# but lazy-load the nvm function itself for version switching
if [[ -d "$NVM_DIR/versions/node" ]]; then
  # Use the latest installed version (sorted by version)
  NVM_LATEST_VERSION=$(command ls -1 "$NVM_DIR/versions/node" | sort -V | tail -1)
  if [[ -n "$NVM_LATEST_VERSION" && -d "$NVM_DIR/versions/node/$NVM_LATEST_VERSION" ]]; then
    export PATH="$NVM_DIR/versions/node/$NVM_LATEST_VERSION/bin:$PATH"
  fi
fi

# Lazy load nvm function only when explicitly called (for version switching)
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  nvm() {
    unset -f nvm
    \. "$NVM_DIR/nvm.sh"
    nvm "$@"
  }
fi

# ----- USER CUSTOMIZATIONS -----
if [[ -f "$HOME/.zshrc.local" ]]; then
  source "$HOME/.zshrc.local"
fi
